# ── Build stage ──────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# ── Runtime stage ────────────────────────────────────────────
FROM node:20-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist

# Non-root user
RUN addgroup -S mcp && adduser -S mcp -G mcp
USER mcp

EXPOSE 3100
ENV MCP_TRANSPORT=http \
    MCP_HTTP_PORT=3100 \
    AETHERIA_URL=https://eatheria.com

# In HTTP mode each request carries its own Bearer key; AETHERIA_API_KEY
# is only a fallback for stdio deployments.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -T 3 -O /dev/null http://127.0.0.1:3100/mcp || [ $? -eq 8 ]

CMD ["node", "dist/index.js"]
