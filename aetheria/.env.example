# Database
DATABASE_URL=postgresql://user:password@host:5432/aetheriadb

# Google AI
GOOGLE_API_KEY=your-google-ai-api-key

# NextAuth
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Encryption (for API keys stored in DB)
ENCRYPTION_KEY=generate-a-64-char-hex-key-here-use-openssl-rand-hex-32

# Messaging (optional)
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# Max concurrent WhatsApp (QR) sessions. Sessions run on Baileys (pure Node,
# no browser) so they are lightweight — this cap is just a safety valve.
# MAX_CONCURRENT_WA_SESSIONS=5
# Where Baileys stores per-session device credentials (relative to the app dir).
# BAILEYS_AUTH_DIR=.baileys_auth

# App
NODE_ENV=development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
