# ============================================================
# AETHERIA — archivo de ignorados para herramientas de IA / búsqueda
#
# Convención `.ignore` de ripgrep. Hace que los asistentes de IA y las
# búsquedas de código (Grep, indexado semántico, etc.) NO pierdan tokens
# leyendo librerías, artefactos de build, cachés, secretos o docs generados.
#
# IMPORTANTE: este archivo NO afecta a git (para eso está .gitignore).
# Se aplica de forma recursiva a todo el árbol del workspace, incluidos
# los archivos que SÍ están trackeados por git (p.ej. package-lock.json).
# ============================================================

# ── Dependencias / librerías (no aportan al desarrollo) ──────────────────────
node_modules/
.pnp
.pnp.*
.yarn/
vendor/

# ── Artefactos de build / compilación ────────────────────────────────────────
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
src/generated/

# ── Lockfiles (enormes, valor nulo para entender el código) ──────────────────
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml

# ── Artefactos de tests / cobertura ──────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Secretos / credenciales (NUNCA deben leerse en voz alta) ─────────────────
.env
.env.*
!.env.example
*.pem
*.key
ssh/
.wwebjs_auth/
.wwebjs_cache/

# ── Cachés y docs generados por el IDE / herramientas ────────────────────────
.qoder/
.windsurf/
.husky/_/
.vercel/

# ── Datos de demo / subidas de usuarios ──────────────────────────────────────
demo-data/
uploads/
scripts/e2e/

# ── Basura de sistema ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
